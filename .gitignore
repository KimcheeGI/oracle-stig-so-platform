# Packer secrets - never commit
packer/secrets.pkrvars.hcl

# Ignore offline assets and large build artifacts
/offline-assets/
/packer/box_cache/
/packer/packer_cache/
/packer/output-oracle_linux/
/packer/output-*/
*.ova
*.ovf
*.tar.gz

# Packer build logs
build-*.log
packer/build-*.log

# Ansible vault password and other secrets (do not commit)
/ansible/.vault_pass
/ansible/vault.yml

# Editor and system files
.DS_Store
*.swp
.vscode/
